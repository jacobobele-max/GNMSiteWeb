# Copier ce fichier en ".env" (non versionné) et renseigner les valeurs
# réelles avant de lancer `npm run build`.

# Identifiant de mesure Google Analytics 4 (format "G-XXXXXXXXXX").
# Créer une propriété GA4 sur https://analytics.google.com puis
# Admin > Flux de données > Web > copier l'"ID de mesure".
# Laisser vide/absent désactive le tracking (aucun impact sur le site).
VITE_GA_MEASUREMENT_ID=
